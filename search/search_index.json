{"config":{"lang":["ja"],"separator":"[\\s\\-\u3000\u3001\u3002\uff0c\uff0e]+","pipeline":["stemmer"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"Home","text":"\u5fd8\u5374\u200b\u68ee\u200b  <p> FORGET FOREST MOD API </p> <p> \u200b\u6697\u200b\u3044\u200b\u68ee\u200b\u3067\u200b\u9375\u200b\u3092\u200b\u96c6\u200b\u3081\u3001\u200b\u8131\u51fa\u200b\u3092\u200b\u76ee\u6307\u200b\u305b\u3002 Mod\u3067\u200b\u4e16\u754c\u200b\u3092\u200b\u62e1\u200b\u5f35\u200b\u3057\u3088\u3046\u3002 </p> <ul> <li> <p> \u30d7\u30ec\u30a4\u30e4\u30fc\u200b\u5411\u200b\u3051</p> <p>Mod\u306e\u200b\u5c0e\u5165\u200b\u65b9\u6cd5\u200b\u3092\u200b\u89e3\u200b\u8aac\u200b\u3002 <code>.fm</code> \u3092\u200b\u5165\u200b\u308c\u308b\u3060\u3051\u3002</p> <p>\u200b\u5c0e\u5165\u200b\u30ac\u30a4\u30c9 </p> </li> <li> <p> \u200b\u958b\u200b\u767a\u200b\u8005\u200b\u5411\u200b\u3051</p> <p>Mod\u200b\u4f5c\u6210\u200b\u306e\u306f\u3058\u3081\u304b\u305f\u3002 \u200b\u6700\u5c0f\u200b\u30c6\u30f3\u30d7\u30ec\u30fc\u30c8\u304b\u3089\u3002</p> <p>\u30af\u30a4\u30c3\u30af\u30b9\u30bf\u30fc\u30c8 </p> </li> <li> <p> API\u30ea\u30d5\u30a1\u30ec\u30f3\u30b9</p> <p>ForgetAPI\u306e\u200b\u5168\u6a5f\u200b\u80fd\u200b\u3002 Entity, Item, Achievement...</p> <p>API Docs </p> </li> <li> <p> \u200b\u914d\u5e03\u200b\u524d\u200b\u30c1\u30a7\u30c3\u30af</p> <p>\u200b\u516c\u958b\u200b\u524d\u200b\u306b\u200b\u78ba\u8a8d\u200b\u3059\u3079\u304d\u200b\u9805\u76ee\u200b\u3002</p> <p>\u30c1\u30a7\u30c3\u30af\u30ea\u30b9\u30c8 </p> </li> </ul>  \u00a9 Conbi Fan \u00b7 ForgetAPI v1.0.0"},{"location":"api/core/","title":"ForgetAPI Reference","text":"<p>\u200b\u5168\u200bAPI\u306e\u30ea\u30d5\u30a1\u30ec\u30f3\u30b9\u3002</p>"},{"location":"api/core/#core","title":"Core","text":""},{"location":"api/core/#getversion","title":"getVersion()","text":"<p>API\u30d0\u30fc\u30b8\u30e7\u30f3\u3092\u200b\u8fd4\u200b\u3059\u3002</p> <pre><code>ForgetAPI.getVersion(); // \"1.0.0\"\n</code></pre>"},{"location":"api/core/#getinfo","title":"getInfo()","text":"<p>API\u200b\u60c5\u5831\u200b\u3092\u30aa\u30d6\u30b8\u30a7\u30af\u30c8\u3067\u200b\u8fd4\u200b\u3059\u3002</p> <pre><code>ForgetAPI.getInfo();\n// {name:\"ForgetAPI\", version:\"1.0.0\"}\n</code></pre>"},{"location":"api/core/#saferuncallback-modname","title":"safeRun(callback, modName)","text":"<p>\u30a8\u30e9\u30fc\u3092\u200b\u9694\u96e2\u200b\u3057\u3066\u200b\u5b9f\u200b\u884c\u200b\u3002\u200b\u4f8b\u5916\u200b\u6642\u200bnull\u200b\u8fd4\u200b\u5374\u200b\u3002</p> <pre><code>ForgetAPI.safeRun(() =&gt; {\n    // \u200b\u5371\u200b\u967a\u200b\u306a\u200b\u51e6\u200b\u7406\u200b\n}, \"MyMod\");\n</code></pre>"},{"location":"api/core/#registermodmod","title":"registerMod(mod)","text":"<p>Mod\u3092\u200b\u767b\u200b\u9332\u200b\u3002\u200b\u901a\u5e38\u200b\u306f\u30ed\u30fc\u30c0\u30fc\u304c\u200b\u81ea\u52d5\u200b\u547c\u51fa\u200b\u3002</p> <pre><code>ForgetAPI.registerMod({\n    name: \"MyMod\",\n    version: \"1.0.0\",\n    instance: modInstance\n});\n</code></pre>"},{"location":"api/core/#logger","title":"Logger","text":""},{"location":"api/core/#loggerinfomsg-warnmsg-errormsg","title":"logger.info(msg) / warn(msg) / error(msg)","text":"<pre><code>ForgetAPI.logger.info(\"loaded\");\nForgetAPI.logger.warn(\"deprecated\");\nForgetAPI.logger.error(\"not found\");\n</code></pre>"},{"location":"api/core/#getlogs","title":"getLogs()","text":"<p>\u200b\u5168\u200b\u30ed\u30b0\u200b\u5c65\u200b\u6b74\u200b\u3092\u200b\u914d\u5217\u200b\u3067\u200b\u8fd4\u200b\u3059\u3002</p> <pre><code>ForgetAPI.getLogs();\n// [{type, message, time}, ...]\n</code></pre>"},{"location":"api/core/#event","title":"Event","text":""},{"location":"api/core/#eventonname-callback","title":"event.on(name, callback)","text":"<pre><code>ForgetAPI.event.on(\n    \"achievementUnlock\",\n    (data) =&gt; console.log(data.id)\n);\n</code></pre>"},{"location":"api/core/#eventemitname-data","title":"event.emit(name, data)","text":"<pre><code>ForgetAPI.event.emit(\"myEvent\", {key: \"val\"});\n</code></pre>"},{"location":"api/core/#eventoffname-callback","title":"event.off(name, callback)","text":"<pre><code>ForgetAPI.event.off(\"myEvent\", cb);\n</code></pre>"},{"location":"api/core/#_1","title":"\u7d44\u200b\u307f\u200b\u8fbc\u200b\u307f\u30a4\u30d9\u30f3\u30c8","text":"\u30a4\u30d9\u30f3\u30c8 \u30c7\u30fc\u30bf \u200b\u8aac\u200b\u660e\u200b achievementUnlock {id} \u200b\u5b9f\u200b\u7e3e\u200b\u89e3\u9664\u200b entitySpawn {id,pos,health} \u200b\u751f\u6210\u200b itemGive {player,item,count} \u200b\u4ed8\u4e0e\u200b mapLoad {map} \u30de\u30c3\u30d7\u200b\u8aad\u200b\u8fbc\u200b gamePause - \u30dd\u30fc\u30ba\u200b\u958b\u59cb\u200b gameResume - \u30dd\u30fc\u30ba\u200b\u89e3\u9664\u200b gameRestart - \u200b\u518d\u958b\u200b gameQuit - \u200b\u7d42\u4e86\u200b stateChange {state} \u200b\u72b6\u614b\u200b\u5909\u200b\u66f4\u200b menuOpen {menu} \u30e1\u30cb\u30e5\u30fc\u200b\u8868\u793a\u200b notification {message,type} \u200b\u901a\u77e5\u200b soundPlay {id,volume} \u200b\u518d\u751f\u200b soundStop {id} \u200b\u505c\u6b62\u200b shaderApply {shader} \u200b\u9069\u7528\u200b shaderDisable - \u200b\u7121\u200b\u52b9\u200b\u5316\u200b cameraMove {pos} \u30ab\u30e1\u30e9\u200b\u79fb\u52d5\u200b cameraShake {power,time} \u30b7\u30a7\u30a4\u30af particleSpawn {id,pos} \u30d1\u30fc\u30c6\u30a3\u30af\u30eb ambientChange {value} \u200b\u74b0\u5883\u200b\u5149\u200b fogColorChange {color} \u200b\u9727\u8272\u200b postEffectEnable {effect} PE\u200b\u6709\u200b\u52b9\u200b postEffectDisable {id} PE\u200b\u7121\u200b\u52b9\u200b jumpscare {data} \u30b8\u30e3\u30f3\u30d7\u30b9\u30b1\u30a2 fearChange {value} \u200b\u6050\u6016\u200b\u5024\u200b atmosphereChange {data} \u200b\u96f0\u200b\u56f2\u200b\u6c17\u200b modRegister {mod} Mod\u200b\u767b\u200b\u9332\u200b modEnable {mod} Mod\u200b\u6709\u200b\u52b9\u200b modDisable {mod} Mod\u200b\u7121\u200b\u52b9\u200b modReload {mod} Mod\u30ea\u30ed\u30fc\u30c9 resourceReload - \u30ea\u30bd\u30fc\u30b9\u200b\u518d\u200b\u8aad\u200b\u8fbc\u200b renderQualityChange {q} \u200b\u63cf\u753b\u200b\u54c1\u8cea\u200b rendererReload - \u30ec\u30f3\u30c0\u30e9\u30fc\u200b\u518d\u200b\u8aad\u200b\u8fbc\u200b weatherChange {type} \u200b\u5929\u5019\u200b timeChange {value} \u200b\u6642\u9593\u200b questComplete {quest,player} \u30af\u30a8\u30b9\u30c8\u200b\u5b8c\u200b\u4e86\u200b questReward {id,reward} \u200b\u5831\u916c\u200b storyPlay {scene} \u30b9\u30c8\u30fc\u30ea\u30fc\u200b\u518d\u751f\u200b storyStop - \u30b9\u30c8\u30fc\u30ea\u30fc\u200b\u505c\u6b62\u200b dialogue {char,text} \u30c0\u30a4\u30a2\u30ed\u30b0 animationPlay {id,target} \u30a2\u30cb\u30e1\u200b\u518d\u751f\u200b animationStop {id,target} \u30a2\u30cb\u30e1\u200b\u505c\u6b62\u200b playerTeleport {player} \u30c6\u30ec\u30dd\u30fc\u30c8 recipeAdd {data} \u30ec\u30b7\u30d4\u200b\u8ffd\u52a0"},{"location":"api/core/#entity","title":"Entity","text":""},{"location":"api/core/#entityadddata","title":"entity.add(data)","text":"<pre><code>ForgetAPI.entity.add({\n    id:\"ghost\", name:\"Ghost\", health:100\n});\n</code></pre>"},{"location":"api/core/#entitygetid-removeid-getall","title":"entity.get(id) / remove(id) / getAll()","text":"<pre><code>ForgetAPI.entity.get(\"ghost\");\nForgetAPI.entity.remove(\"ghost\");\nForgetAPI.entity.getAll();\n</code></pre>"},{"location":"api/core/#entityspawnid-position","title":"entity.spawn(id, position)","text":"<pre><code>ForgetAPI.entity.spawn(\"ghost\", {x:10,y:0,z:20});\n</code></pre>"},{"location":"api/core/#entitysetmodelid-file-settextureid-file","title":"entity.setModel(id, file) / setTexture(id, file)","text":"<pre><code>ForgetAPI.entity.setModel(\"ghost\",\"g.obj\");\nForgetAPI.entity.setTexture(\"ghost\",\"g.png\");\n</code></pre>"},{"location":"api/core/#entityaddcomponentid-name-data","title":"entity.addComponent(id, name, data)","text":"<pre><code>ForgetAPI.entity.addComponent(\"ghost\",\"ai\",{type:\"patrol\"});\n</code></pre>"},{"location":"api/core/#entityregisteraiid-ai","title":"entity.registerAI(id, ai)","text":"<pre><code>ForgetAPI.entity.registerAI(\"ghost\", ai);\n</code></pre>"},{"location":"api/core/#item","title":"Item","text":""},{"location":"api/core/#itemadddata-getid-removeid","title":"item.add(data) / get(id) / remove(id)","text":"<pre><code>ForgetAPI.item.add({id:\"key_red\", name:\"\u200b\u8d64\u200b\u3044\u200b\u9375\u200b\"});\nForgetAPI.item.get(\"key_red\");\nForgetAPI.item.remove(\"key_red\");\n</code></pre>"},{"location":"api/core/#itemgiveplayer-id-count","title":"item.give(player, id, count)","text":"<pre><code>ForgetAPI.item.give(\"p1\",\"key_red\",1);\n</code></pre>"},{"location":"api/core/#itemuseid-callback","title":"item.use(id, callback)","text":"<pre><code>ForgetAPI.item.use(\"potion\",()=&gt;heal(50));\n</code></pre>"},{"location":"api/core/#itemrecipedata","title":"item.recipe(data)","text":"<pre><code>ForgetAPI.item.recipe({output:\"sword\", input:[\"iron\",\"stick\"]});\n</code></pre>"},{"location":"api/core/#object","title":"Object","text":""},{"location":"api/core/#objectadddata-getid-removeid","title":"object.add(data) / get(id) / remove(id)","text":"<pre><code>ForgetAPI.object.add({id:\"door\",name:\"\u200b\u6249\u200b\"});\nForgetAPI.object.get(\"door\");\nForgetAPI.object.remove(\"door\");\n</code></pre>"},{"location":"api/core/#objectreplaceid-data","title":"object.replace(id, data)","text":"<pre><code>ForgetAPI.object.replace(\"door\",{name:\"\u200b\u9244\u200b\u6249\u200b\"});\n</code></pre>"},{"location":"api/core/#objectinteractid-callback","title":"object.interact(id, callback)","text":"<pre><code>ForgetAPI.object.interact(\"door\", ()=&gt;openDoor());\n</code></pre>"},{"location":"api/core/#player","title":"Player","text":""},{"location":"api/core/#playerregisterid-data","title":"player.register(id, data)","text":"<pre><code>ForgetAPI.player.register(\"p1\",{health:100, position:{x:0,y:0,z:0}});\n</code></pre>"},{"location":"api/core/#playergetid","title":"player.get(id)","text":"<pre><code>ForgetAPI.player.get(\"p1\");\n</code></pre>"},{"location":"api/core/#playerteleportid-pos","title":"player.teleport(id, pos)","text":"<pre><code>ForgetAPI.player.teleport(\"p1\", {x:50,y:0,z:50});\n</code></pre>"},{"location":"api/core/#playerdamageid-value-healid-value","title":"player.damage(id, value) / heal(id, value)","text":"<pre><code>ForgetAPI.player.damage(\"p1\", 20);\nForgetAPI.player.heal(\"p1\", 30);\n</code></pre>"},{"location":"api/core/#playersetstatusid-status-value","title":"player.setStatus(id, status, value)","text":"<pre><code>ForgetAPI.player.setStatus(\"p1\",\"fear\",80);\n</code></pre>"},{"location":"api/core/#playerinventoryid","title":"player.inventory(id)","text":"<pre><code>ForgetAPI.player.inventory(\"p1\");\n</code></pre>"},{"location":"api/core/#map","title":"Map","text":""},{"location":"api/core/#mapadddata-getid-removeid","title":"map.add(data) / get(id) / remove(id)","text":"<pre><code>ForgetAPI.map.add({id:\"forest\",name:\"\u200b\u68ee\u200b\"});\nForgetAPI.map.get(\"forest\");\nForgetAPI.map.remove(\"forest\");\n</code></pre>"},{"location":"api/core/#mapreplaceid-data-loadid","title":"map.replace(id, data) / load(id)","text":"<pre><code>ForgetAPI.map.replace(\"forest\",{fog:0.06});\nForgetAPI.map.load(\"forest\");\n</code></pre>"},{"location":"api/core/#world","title":"World","text":""},{"location":"api/core/#worldsettimevalue-gettime","title":"world.setTime(value) / getTime()","text":"<pre><code>ForgetAPI.world.setTime(18000);\nForgetAPI.world.getTime();\n</code></pre>"},{"location":"api/core/#worldsetweathertype-getweather","title":"world.setWeather(type) / getWeather()","text":"<pre><code>ForgetAPI.world.setWeather(\"rain\");\nForgetAPI.world.getWeather();\n</code></pre>"},{"location":"api/core/#worldsetfogdata-getfog","title":"world.setFog(data) / getFog()","text":"<pre><code>ForgetAPI.world.setFog({density:0.05});\nForgetAPI.world.getFog();\n</code></pre>"},{"location":"api/core/#worldaddobjectdata","title":"world.addObject(data)","text":"<pre><code>ForgetAPI.world.addObject({type:\"tree\", pos:{x:10,y:0,z:20}});\n</code></pre>"},{"location":"api/core/#achievement","title":"Achievement","text":""},{"location":"api/core/#achievementinitfilepath","title":"achievement.init(filePath)","text":"<pre><code>ForgetAPI.achievement.init(\"config/achievements.json\");\n</code></pre>"},{"location":"api/core/#achievementadddata","title":"achievement.add(data)","text":"<pre><code>ForgetAPI.achievement.add({id:\"first_key\", name:\"\u200b\u6700\u521d\u200b\u306e\u200b\u9375\u200b\"});\n</code></pre>"},{"location":"api/core/#achievementunlockid","title":"achievement.unlock(id)","text":"<pre><code>ForgetAPI.achievement.unlock(\"first_key\");\n</code></pre>"},{"location":"api/core/#achievementhasid","title":"achievement.has(id)","text":"<pre><code>ForgetAPI.achievement.has(\"first_key\"); // true/false\n</code></pre>"},{"location":"api/core/#achievementlist","title":"achievement.list()","text":"<pre><code>ForgetAPI.achievement.list();\n</code></pre>"},{"location":"api/core/#quest","title":"Quest","text":""},{"location":"api/core/#questadddata-getid","title":"quest.add(data) / get(id)","text":"<pre><code>ForgetAPI.quest.add({id:\"q1\", name:\"\u200b\u9375\u200b\u3092\u200b\u96c6\u200b\u3081\u308d\"});\nForgetAPI.quest.get(\"q1\");\n</code></pre>"},{"location":"api/core/#questcompleteid-player-rewardid-reward","title":"quest.complete(id, player) / reward(id, reward)","text":"<pre><code>ForgetAPI.quest.complete(\"q1\",\"p1\");\nForgetAPI.quest.reward(\"q1\",{xp:100});\n</code></pre>"},{"location":"api/core/#horror","title":"Horror","text":""},{"location":"api/core/#horroraddjumpscaredata-playjumpscareid","title":"horror.addJumpscare(data) / playJumpscare(id)","text":"<pre><code>ForgetAPI.horror.addJumpscare({id:\"scare1\", sound:\"scream.ogg\"});\nForgetAPI.horror.playJumpscare(\"scare1\");\n</code></pre>"},{"location":"api/core/#horrorsetfearvalue-fogvalue","title":"horror.setFear(value) / fog(value)","text":"<pre><code>ForgetAPI.horror.setFear(80);\nForgetAPI.horror.fog(0.06);\n</code></pre>"},{"location":"api/core/#horrorsetatmospheredata","title":"horror.setAtmosphere(data)","text":"<pre><code>ForgetAPI.horror.setAtmosphere({fog:0.08, light:0.2});\n</code></pre>"},{"location":"api/core/#story","title":"Story","text":""},{"location":"api/core/#storyaddscenedata-playid-stop","title":"story.addScene(data) / play(id) / stop()","text":"<pre><code>ForgetAPI.story.addScene({id:\"intro\", text:\"\u200b\u68ee\u200b\u306b\u200b\u8ff7\u200b\u3044\u200b\u8fbc\u200b\u3093\u3060...\"});\nForgetAPI.story.play(\"intro\");\nForgetAPI.story.stop();\n</code></pre>"},{"location":"api/core/#storydialoguecharacter-text","title":"story.dialogue(character, text)","text":"<pre><code>ForgetAPI.story.dialogue(\"???\", \"\u200b\u8ab0\u200b\u3060...?\");\n</code></pre>"},{"location":"api/core/#ui","title":"UI","text":""},{"location":"api/core/#uiaddmenudata-removemenuid-showmenuid","title":"ui.addMenu(data) / removeMenu(id) / showMenu(id)","text":"<pre><code>ForgetAPI.ui.addMenu({id:\"shop\",title:\"\u200b\u5e97\u200b\"});\nForgetAPI.ui.showMenu(\"shop\");\n</code></pre>"},{"location":"api/core/#uinotificationmessage-type","title":"ui.notification(message, type)","text":"<pre><code>ForgetAPI.ui.notification(\"\u200b\u4fdd\u5b58\u200b\u3057\u305f\",\"info\");\n</code></pre>"},{"location":"api/core/#uiaddbuttonmenu-id-data","title":"ui.addButton(menu, id, data)","text":"<pre><code>ForgetAPI.ui.addButton(\"shop\",\"buy\",{label:\"\u200b\u8cfc\u5165\u200b\"});\n</code></pre>"},{"location":"api/core/#sound","title":"Sound","text":""},{"location":"api/core/#soundaddid-file-getid-removeid","title":"sound.add(id, file) / get(id) / remove(id)","text":"<pre><code>ForgetAPI.sound.add(\"bgm\",\"bgm.ogg\");\nForgetAPI.sound.get(\"bgm\");\n</code></pre>"},{"location":"api/core/#soundplayid-volume-stopid","title":"sound.play(id, volume) / stop(id)","text":"<pre><code>ForgetAPI.sound.play(\"bgm\", 0.8);\nForgetAPI.sound.stop(\"bgm\");\n</code></pre>"},{"location":"api/core/#texture-model-animation","title":"Texture / Model / Animation","text":""},{"location":"api/core/#textureadd-replace-remove-get","title":"texture.add / replace / remove / get","text":"<pre><code>ForgetAPI.texture.add(\"t1\",\"tex.png\");\nForgetAPI.texture.replace(\"t1\",\"new.png\");\n</code></pre>"},{"location":"api/core/#modeladd-get-replace-remove","title":"model.add / get / replace / remove","text":"<pre><code>ForgetAPI.model.add({id:\"m1\",file:\"m.obj\"});\n</code></pre>"},{"location":"api/core/#animationadd-get-play-stop","title":"animation.add / get / play / stop","text":"<pre><code>ForgetAPI.animation.add({id:\"walk\"});\nForgetAPI.animation.play(\"walk\",\"ghost\");\nForgetAPI.animation.stop(\"walk\",\"ghost\");\n</code></pre>"},{"location":"api/core/#shader-posteffect-renderer","title":"Shader / PostEffect / Renderer","text":""},{"location":"api/core/#shaderadd-apply-disable","title":"shader.add / apply / disable","text":"<pre><code>ForgetAPI.shader.add({id:\"blur\"});\nForgetAPI.shader.apply(\"blur\");\nForgetAPI.shader.disable();\n</code></pre>"},{"location":"api/core/#posteffectadd-enable-disable","title":"postEffect.add / enable / disable","text":"<pre><code>ForgetAPI.postEffect.add({id:\"vignette\"});\nForgetAPI.postEffect.enable(\"vignette\");\n</code></pre>"},{"location":"api/core/#renderersetquality-setresolution-reload","title":"renderer.setQuality / setResolution / reload","text":"<pre><code>ForgetAPI.renderer.setQuality(\"high\");\nForgetAPI.renderer.setResolution(1920,1080);\nForgetAPI.renderer.reload();\n</code></pre>"},{"location":"api/core/#particle-lighting-camera","title":"Particle / Lighting / Camera","text":""},{"location":"api/core/#particleadd-spawn-remove","title":"particle.add / spawn / remove","text":"<pre><code>ForgetAPI.particle.add({id:\"fire\"});\nForgetAPI.particle.spawn(\"fire\",{x:0,y:0,z:0});\n</code></pre>"},{"location":"api/core/#lightingadd-setambient-setfogcolor","title":"lighting.add / setAmbient / setFogColor","text":"<pre><code>ForgetAPI.lighting.add({id:\"torch\"});\nForgetAPI.lighting.setAmbient(0.3);\nForgetAPI.lighting.setFogColor(0x010101);\n</code></pre>"},{"location":"api/core/#cameramove-shake-reset","title":"camera.move / shake / reset","text":"<pre><code>ForgetAPI.camera.move({x:0,y:5,z:0});\nForgetAPI.camera.shake(0.5, 30);\nForgetAPI.camera.reset();\n</code></pre>"},{"location":"api/core/#save-config","title":"Save / Config","text":""},{"location":"api/core/#saveset-get-remove-all-clear","title":"save.set / get / remove / all / clear","text":"<pre><code>ForgetAPI.save.set(\"score\",100);\nForgetAPI.save.get(\"score\");\nForgetAPI.save.all();\n</code></pre>"},{"location":"api/core/#configset-get-has-remove","title":"config.set / get / has / remove","text":"<pre><code>ForgetAPI.config.set(\"diff\",\"hard\");\nForgetAPI.config.get(\"diff\",\"normal\");\n</code></pre>"},{"location":"api/core/#registry-statistics-scheduler","title":"Registry / Statistics / Scheduler","text":""},{"location":"api/core/#registryregister-get-getall","title":"registry.register / get / getAll","text":"<pre><code>ForgetAPI.registry.register(\"block\",\"stone\",{hardness:3});\nForgetAPI.registry.get(\"block\",\"stone\");\n</code></pre>"},{"location":"api/core/#statisticsadd-get-reset","title":"statistics.add / get / reset","text":"<pre><code>ForgetAPI.statistics.add(\"kills\",1);\nForgetAPI.statistics.get(\"kills\");\n</code></pre>"},{"location":"api/core/#schedulerrun-repeat-cancel","title":"scheduler.run / repeat / cancel","text":"<pre><code>const id = ForgetAPI.scheduler.run(()=&gt;console.log(\"done\"), 1000);\nForgetAPI.scheduler.cancel(id);\n</code></pre>"},{"location":"api/core/#game-permission-dependency","title":"Game / Permission / Dependency","text":""},{"location":"api/core/#gamepause-resume-getstate","title":"game.pause / resume / getState","text":"<pre><code>ForgetAPI.game.pause();\nForgetAPI.game.resume();\nForgetAPI.game.getState(); // \"paused\"\n</code></pre>"},{"location":"api/core/#permissionadd-has-remove","title":"permission.add / has / remove","text":"<pre><code>ForgetAPI.permission.add(\"admin\",\"conbi\");\nForgetAPI.permission.has(\"admin\",\"conbi\");\n</code></pre>"},{"location":"api/core/#dependencyrequire-check","title":"dependency.require / check","text":"<pre><code>ForgetAPI.dependency.require(\"DLCAPI\");\nForgetAPI.dependency.check([\"DLCAPI\"]);\n</code></pre>"},{"location":"api/core/#resource-localization-lang","title":"Resource / Localization / Lang","text":""},{"location":"api/core/#resourcetexture-sound-model-reload","title":"resource.texture / sound / model / reload","text":"<pre><code>ForgetAPI.resource.texture(\"t1\",\"t.png\");\nForgetAPI.resource.reload();\n</code></pre>"},{"location":"api/core/#localizationadd-get","title":"localization.add / get","text":"<pre><code>ForgetAPI.localization.add(\"ja\",\"title\",\"\u200b\u5fd8\u5374\u200b\u68ee\u200b\");\nForgetAPI.localization.get(\"ja\",\"title\");\n</code></pre>"},{"location":"api/core/#langadd-get-setlanguage-current","title":"lang.add / get / setLanguage / current","text":"<pre><code>ForgetAPI.lang.add(\"title\",\"\u200b\u5fd8\u5374\u200b\u68ee\u200b\");\nForgetAPI.lang.setLanguage(\"ja\");\nForgetAPI.lang.current(); // \"ja\"\n</code></pre>"},{"location":"api/core/#math-file-network-timer","title":"Math / File / Network / Timer","text":""},{"location":"api/core/#mathrandom-clamp-lerp-distance","title":"math.random / clamp / lerp / distance","text":"<pre><code>ForgetAPI.math.random(1,10);\nForgetAPI.math.clamp(15,0,10); // 10\nForgetAPI.math.lerp(0,100,0.5); // 50\n</code></pre>"},{"location":"api/core/#fileread-write-exists-remove","title":"file.read / write / exists / remove","text":"<pre><code>ForgetAPI.file.exists(\"mods/mod.txt\");\n</code></pre>"},{"location":"api/core/#networksend-receive-disconnect","title":"network.send / receive / disconnect","text":"<pre><code>ForgetAPI.network.send(\"ch\",{msg:\"hi\"});\n</code></pre>"},{"location":"api/core/#timersettimeout-setinterval-clear","title":"timer.setTimeout / setInterval / clear","text":"<pre><code>ForgetAPI.timer.setTimeout(()=&gt;{},1000);\n</code></pre>"},{"location":"guide/fm-spec/","title":".fm\u30d5\u30a1\u30a4\u30eb\u200b\u4ed5\u200b\u69d8","text":""},{"location":"guide/fm-spec/#_1","title":"\u6982\u8981","text":"<p><code>.fm</code> \u306f\u200b\u5fd8\u5374\u200b\u68ee\u200b\u306eMod\u200b\u914d\u5e03\u200b\u30d5\u30a9\u30fc\u30de\u30c3\u30c8\u3002 \u200b\u5b9f\u200b\u4f53\u200b\u306fZIP\u30a2\u30fc\u30ab\u30a4\u30d6\u3067\u3001\u200b\u4e2d\u200b\u306b <code>mod.json</code> \u3068\u30b3\u30fc\u30c9\u3092\u200b\u542b\u200b\u307f\u307e\u3059\u3002</p>"},{"location":"guide/fm-spec/#_2","title":"\u5185\u90e8\u200b\u69cb\u9020","text":"<pre><code>MyMod.fm (ZIP)\n\u251c\u2500\u2500 mod.json   \u2190 \u200b\u5fc5\u9808\u200b\n\u251c\u2500\u2500 main.js    \u2190 \u200b\u5fc5\u9808\u200b\n\u2514\u2500\u2500 ...        \u2190 \u200b\u4efb\u610f\u200b\n</code></pre>"},{"location":"guide/fm-spec/#_3","title":"\u5236\u7d04","text":"\u9805\u76ee\u200b \u200b\u5236\u9650\u200b \u200b\u62e1\u200b\u5f35\u5b50\u200b .fm \u30d5\u30a9\u30fc\u30de\u30c3\u30c8 ZIP \u30a8\u30f3\u30c8\u30ea mod.json\u306emain\u30d5\u30a3\u30fc\u30eb\u30c9 API\u200b\u4e92\u63db\u200b api\u30d5\u30a3\u30fc\u30eb\u30c9\u3067\u200b\u5ba3\u8a00\u200b \u30b5\u30a4\u30ba\u200b\u4e0a\u9650\u200b 50MB\uff08\u200b\u63a8\u200b\u5968\u200b\uff09"},{"location":"guide/fm-spec/#_4","title":"\u30d0\u30fc\u30b8\u30e7\u30f3\u200b\u4e92\u63db\u6027","text":"<p><code>mod.json</code> \u306e <code>api</code> \u304c\u30b2\u30fc\u30e0\u200b\u672c\u4f53\u200b\u306eForgetAPI\u30d0\u30fc\u30b8\u30e7\u30f3\u3068\u200b\u4e00\u81f4\u200b\u3057\u306a\u3044\u200b\u5834\u5408\u200b\u3001\u305d\u306eMod\u306f\u30b9\u30ad\u30c3\u30d7\u3055\u308c\u307e\u3059\u3002</p> <pre><code>{ \"api\": \"1.0.0\" }\n</code></pre>"},{"location":"guide/fm-spec/#_5","title":"\u5165\u200b\u308c\u200b\u5b50\u200b\u69cb\u9020\u200b\u3078\u306e\u200b\u5bfe\u200b\u5fdc","text":"<p>ZIP\u200b\u5185\u200b\u306b\u30d5\u30a9\u30eb\u30c0\u304c\u200b\u542b\u200b\u307e\u308c\u3066\u3044\u3066\u3082\u3001\u30ed\u30fc\u30c0\u30fc\u304c1\u200b\u968e\u5c64\u200b\u307e\u3067\u200b\u81ea\u52d5\u200b\u63a2\u7d22\u200b\u3057\u307e\u3059\u3002</p> <pre><code>MyMod.fm\n\u2514\u2500\u2500 MyMod/\n    \u251c\u2500\u2500 mod.json\n    \u2514\u2500\u2500 main.js\n</code></pre>"},{"location":"guide/mod-author-start/","title":"Mod\u200b\u4f5c\u6210\u200b\u306f\u3058\u3081\u304b\u305f","text":""},{"location":"guide/mod-author-start/#_1","title":"\u5fc5\u8981\u200b\u306a\u3082\u306e","text":"<ul> <li>\u30c6\u30ad\u30b9\u30c8\u30a8\u30c7\u30a3\u30bf\uff08VSCode\u200b\u63a8\u200b\u5968\u200b\uff09</li> <li>Node.js\uff08zip\u200b\u5727\u200b\u7e2e\u200b\u306b\u200b\u4f7f\u7528\u200b\uff09</li> </ul>"},{"location":"guide/mod-author-start/#_2","title":"\u30c7\u30a3\u30ec\u30af\u30c8\u30ea\u200b\u69cb\u9020","text":"<pre><code>MyMod/\n\u251c\u2500\u2500 mod.json\n\u2514\u2500\u2500 main.js\n</code></pre>"},{"location":"guide/mod-author-start/#modjson","title":"mod.json","text":"<pre><code>{\n  \"name\": \"MyMod\",\n  \"version\": \"1.0.0\",\n  \"author\": \"\u3042\u306a\u305f\u306e\u200b\u540d\u524d\u200b\",\n  \"description\": \"Mod\u306e\u200b\u8aac\u200b\u660e\u200b\",\n  \"api\": \"1.0.0\",\n  \"main\": \"main.js\"\n}\n</code></pre>"},{"location":"guide/mod-author-start/#_3","title":"\u30d5\u30a3\u30fc\u30eb\u30c9\u200b\u4e00\u200b\u89a7","text":"\u30d5\u30a3\u30fc\u30eb\u30c9 \u200b\u5fc5\u9808\u200b \u200b\u8aac\u200b\u660e\u200b name \u2705 \u200b\u4e00\u200b\u610f\u200b\u306a\u200b\u540d\u524d\u200b\uff08\u200b\u82f1\u200b\u6570\u5b57\u200b\uff09 version \u2705 \u30bb\u30de\u30f3\u30c6\u30a3\u30c3\u30af\u30d0\u30fc\u30b8\u30e7\u30f3 author \u2705 \u200b\u4f5c\u8005\u200b\u540d\u200b description \u274c Mod\u306e\u200b\u8aac\u200b\u660e\u200b api \u2705 \u200b\u5bfe\u200b\u5fdc\u200bForgetAPI\u30d0\u30fc\u30b8\u30e7\u30f3 main \u2705 \u30a8\u30f3\u30c8\u30ea\u30dd\u30a4\u30f3\u30c8\u30d5\u30a1\u30a4\u30eb"},{"location":"guide/mod-author-start/#mainjs","title":"main.js","text":"<pre><code>module.exports = function(ForgetAPI) {\n\n    ForgetAPI.logger.info(\"MyMod loaded!\");\n\n    return {\n        name: \"MyMod\",\n        version: \"1.0.0\"\n    };\n};\n</code></pre>"},{"location":"guide/mod-author-start/#fm","title":".fm\u30d5\u30a1\u30a4\u30eb\u306e\u200b\u4f5c\u6210","text":"<p>\u30d5\u30a9\u30eb\u30c0\u306e\u200b\u4e2d\u8eab\u200b\u3092zip\u200b\u5727\u200b\u7e2e\u200b\u3057\u3066 \u200b\u62e1\u200b\u5f35\u5b50\u200b\u3092 <code>.fm</code> \u306b\u200b\u5909\u200b\u66f4\u200b\u3002</p> <pre><code>Compress-Archive -Path MyMod\\* -DestinationPath MyMod.zip\nRename-Item MyMod.zip MyMod.fm\n</code></pre> <p>\u200b\u6ce8\u610f\u200b</p> <p>\u30d5\u30a9\u30eb\u30c0\u3054\u3068\u3067\u306f\u306a\u304f\u200b\u4e2d\u8eab\u200b\u3092zip\u306b\u3057\u3066\u304f\u3060\u3055\u3044\u3002 \u200b\u89e3\u51cd\u200b\u5f8c\u200b\u306b <code>mod.json</code> \u304c\u200b\u76f4\u200b\u4e0b\u200b\u306b\u200b\u6765\u200b\u308b\u200b\u5fc5\u8981\u200b\u304c\u3042\u308a\u307e\u3059\u3002</p>"},{"location":"guide/mod-author-start/#_4","title":"\u30c6\u30b9\u30c8","text":"<ol> <li><code>MyMod.fm</code> \u3092 <code>mods/</code> \u306b\u200b\u914d\u7f6e\u200b</li> <li>\u30b2\u30fc\u30e0\u200b\u8d77\u52d5\u200b</li> <li> <p>Console\u306b\u200b\u4ee5\u4e0b\u200b\u304c\u200b\u51fa\u200b\u308c\u3070\u200b\u6210\u529f\u200b</p> <p>[INFO] MyMod loaded!</p> </li> </ol>"},{"location":"guide/mod-author-start/#_5","title":"\u6b21\u200b\u306e\u30b9\u30c6\u30c3\u30d7","text":"<ul> <li>API\u30ea\u30d5\u30a1\u30ec\u30f3\u30b9</li> <li>\u304a\u200b\u83d3\u200b\u5b50\u200bMod\u30c1\u30e5\u30fc\u30c8\u30ea\u30a2\u30eb\uff08\u200b\u6e96\u5099\u200b\u4e2d\u200b\uff09</li> </ul>"},{"location":"guide/player-install/","title":"Mod\u200b\u5c0e\u5165\u200b\u65b9\u6cd5","text":""},{"location":"guide/player-install/#_1","title":"\u5bfe\u200b\u5fdc\u200b\u74b0\u5883","text":"<ul> <li>Windows 64bit</li> <li>\u200b\u5fd8\u5374\u200b\u68ee\u200b v1.0.0\u200b\u4ee5\u4e0a\u200b</li> </ul>"},{"location":"guide/player-install/#_2","title":"\u624b\u9806","text":""},{"location":"guide/player-install/#1-mod","title":"1. Mod\u30d5\u30a1\u30a4\u30eb\u3092\u200b\u5165\u624b","text":"<p><code>.fm</code> \u200b\u62e1\u200b\u5f35\u5b50\u200b\u306e\u30d5\u30a1\u30a4\u30eb\u3092\u30c0\u30a6\u30f3\u30ed\u30fc\u30c9\u3002</p> <p>Mod\u306e\u200b\u63a2\u200b\u3057\u200b\u65b9\u200b</p> <p>GameJolt\u3067 <code>forget-forest-mod</code> \u30bf\u30b0\u3092\u200b\u691c\u200b\u7d22\u200b\u3002</p>"},{"location":"guide/player-install/#2-mods","title":"2. mods\u30d5\u30a9\u30eb\u30c0\u306b\u200b\u914d\u7f6e","text":"<p>\u30a4\u30f3\u30b9\u30c8\u30fc\u30eb\u30d5\u30a9\u30eb\u30c0\u200b\u5185\u200b\u306e <code>mods/</code> \u306b\u30b3\u30d4\u30fc\u3002</p> <pre><code>\u200b\u5fd8\u5374\u200b\u68ee\u200b/\n\u251c\u2500\u2500 \u200b\u5fd8\u5374\u200b\u68ee\u200b.exe\n\u251c\u2500\u2500 mods/\n\u2502   \u251c\u2500\u2500 mod.txt\n\u2502   \u2514\u2500\u2500 YourMod.fm\n\u251c\u2500\u2500 config/\n\u2514\u2500\u2500 saves/\n</code></pre>"},{"location":"guide/player-install/#3-modtxt","title":"3. mod.txt\u3092\u200b\u78ba\u8a8d","text":"<p>\u200b\u4ee5\u4e0b\u200b\u306b\u306a\u3063\u3066\u3044\u308b\u304b\u200b\u78ba\u8a8d\u200b\u3002</p> <pre><code>enable = true\n</code></pre>"},{"location":"guide/player-install/#4","title":"4. \u30b2\u30fc\u30e0\u200b\u8d77\u52d5","text":"<p>\u200b\u81ea\u52d5\u200b\u3067Mod\u304c\u200b\u8aad\u200b\u307f\u200b\u8fbc\u200b\u307e\u308c\u307e\u3059\u3002 \u30bf\u30a4\u30c8\u30eb\u200b\u753b\u9762\u200b\u306e\u300cMod\u300d\u30dc\u30bf\u30f3\u304b\u3089 \u200b\u6709\u200b\u52b9\u200b/\u200b\u7121\u200b\u52b9\u200b\u3092\u200b\u5207\u200b\u308a\u200b\u66